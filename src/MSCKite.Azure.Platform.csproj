<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>MSCKite.Azure.Platform</AssemblyName>
    <RootNamespace>MSCKite.Azure.Platform</RootNamespace>
    <!-- Human-friendly name surfaced in assembly metadata, docs, and package listings -->
    <Product>Azure Platform Kite</Product>
    <AssemblyTitle>Azure Platform Kite</AssemblyTitle>
    <!-- PowerShell doesn't resolve NuGet dependencies on its own, so copy them next to the module -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.0-preview-06">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Source of truth for the module manifest; re-copied to the output dir on every build -->
    <None Include="MSCKite.Azure.Platform.psd1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled PowerShell help generated by platyps.ps1 -Mode Publish; re-copied to the output dir on every build -->
    <None Include="en-US\MSCKite.Azure.Platform.dll-Help.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>en-US\MSCKite.Azure.Platform.dll-Help.xml</Link>
    </None>
  </ItemGroup>

</Project>
