{
    "$schema": "https://raw.githubusercontent.com/msckite/az-platform-kite/refs/heads/main/schemas/platform-config.schema.json",
    "templateVersion": "1.0.0",
    // Phase 1: Azure resource groups are created first, independently of security groups, environments, identities, and GitHub environments.
    "resourceGroups": [
        {
            // Hosts the identity that runs the platform-config.jsonc provisioning pipeline itself.
            "id": "platform",
            "name": "rg-${serviceShort}${uniqueId}-platform-${regionCode}",
            "location": "${location}",
            "tags": {
                "service": "${serviceShort}",
                "environment": "platform",
                "location": "${location}",
                "owner": "engineering-team",
                "criticality": "high",
                "cost-center": "engineering",
                "public": "false"
            }
        },
        {
            "id": "dev",
            "name": "rg-${serviceShort}${uniqueId}-dev-${regionCode}",
            "location": "${location}",
            "tags": {
                "service": "${serviceShort}",
                "environment": "development",
                "location": "${location}",
                "owner": "engineering-team",
                "criticality": "low",
                "cost-center": "engineering",
                "public": "true"
            }
        },
        {
            "id": "stg",
            "name": "rg-${serviceShort}${uniqueId}-stg-${regionCode}",
            "location": "${location}",
            "tags": {
                "service": "${serviceShort}",
                "environment": "staging",
                "location": "${location}",
                "owner": "operational-team",
                "criticality": "medium",
                "cost-center": "operations",
                "public": "true"
            }
        },
        {
            "id": "prd",
            "name": "rg-${serviceShort}${uniqueId}-prd-${regionCode}",
            "location": "${location}",
            "tags": {
                "service": "${serviceShort}",
                "environment": "production",
                "location": "${location}",
                "owner": "business-team",
                "criticality": "high",
                "cost-center": "business",
                "public": "false"
            }
        }
    ],
    // Phase 2: Entra security groups, created once and assigned RBAC roles against every resource group created above.
    "securityGroups": [
        {
            "displayName": "SG ${displayName} - Developers",
            "mailNickname": "sg-${serviceShort}${uniqueId}-devs",
            "description": "Security group for users with developer access to the Azure environments",
            "roleAssignments": [
                {
                    "role": "Contributor",
                    "resourceGroupId": "dev"
                },
                {
                    "role": "Contributor",
                    "resourceGroupId": "stg"
                },
                {
                    "role": "Reader",
                    "resourceGroupId": "prd"
                }
            ]
        },
        {
            "displayName": "SG ${displayName} - Administrators",
            "mailNickname": "sg-${serviceShort}${uniqueId}-admins",
            "description": "Security group for users with administrative access to the Azure environments",
            "roleAssignments": [
                {
                    "role": "Owner",
                    "resourceGroupId": "dev"
                },
                {
                    "role": "Owner",
                    "resourceGroupId": "stg"
                },
                {
                    "role": "Owner",
                    "resourceGroupId": "prd"
                }
            ]
        },
        {
            "displayName": "SG ${displayName} - Stakeholders",
            "mailNickname": "sg-${serviceShort}${uniqueId}-stakeholders",
            "description": "Security group for users with read-only access to the Azure environments",
            "roleAssignments": [
                {
                    "role": "Reader",
                    "resourceGroupId": "dev"
                },
                {
                    "role": "Reader",
                    "resourceGroupId": "stg"
                },
                {
                    "role": "Reader",
                    "resourceGroupId": "prd"
                }
            ]
        }
    ],
    // Phase 3: Entra federated user-assigned identity, Phase 4: GitHub environment (both per-environment).
    "environments": [
        {
            // The bootstrap environment: platform-ci.yml/platform-cd.yml sign in as this identity to run all four
            // phases. Its role assignments are scoped to the whole subscription (not a single resource group).
            "displayName": "Platform",
            "environmentCode": "platform",
            "description": "Bootstrap environment whose identity runs the platform-config.jsonc provisioning pipeline",
            "resourceGroupId": "platform",
            "userAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "scope": "subscription"
                    },
                    {
                        "role": "User Access Administrator", // Needed to assign RBAC roles to the security groups and identities provisioned by phases 2 and 3
                        "scope": "subscription"
                    }
                ]
            },
            "githubEnvironment": {
                "name": "${environmentCode}",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}" // Populated from the clientId of the userAssignedIdentity created above, once it exists
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": []
            }
        },
        {
            "displayName": "Development",
            "environmentCode": "dev",
            "description": "Development environment for the ${displayName} service",
            "resourceGroupId": "dev",
            "userAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "resourceGroupId": "dev"
                    },
                    {
                        "role": "Contributor", // Cross-environment role assignment, to run preflight -WhatIf checks
                        "resourceGroupId": "stg"
                    },
                    {
                        "role": "Azure Deployment Stack Contributor",
                        "resourceGroupId": "dev"
                    }
                ]
            },
            "githubEnvironment": {
                "name": "${environmentCode}-infra",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}"
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": [
                    {
                        "name": "ENV_CODE",
                        "value": "${environmentCode}"
                    },
                    {
                        "name": "RESOURCE_GROUP_NAME",
                        "value": "rg-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    },
                    {
                        "name": "DEPLOYMENT_STACK_NAME",
                        "value": "rgds-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    }
                ]
            },
            // Narrower identity/environment for the workload (application/service/solution code) pipeline: no
            // deployment-stack rights, so developers pushing workload code cannot alter infrastructure through
            // this identity.
            "workloadUserAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}-workload",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}-workload",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "resourceGroupId": "dev"
                    }
                ]
            },
            "workloadGithubEnvironment": {
                "name": "${environmentCode}-workload",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}"
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": [
                    {
                        "name": "ENV_CODE",
                        "value": "${environmentCode}"
                    },
                    {
                        "name": "RESOURCE_GROUP_NAME",
                        "value": "rg-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    }
                ]
            }
        },
        {
            "displayName": "Staging",
            "environmentCode": "stg",
            "description": "Staging environment for the ${displayName} service",
            "resourceGroupId": "stg",
            "userAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "resourceGroupId": "stg"
                    },
                    {
                        "role": "Contributor",
                        "resourceGroupId": "prd"
                    },
                    {
                        "role": "Azure Deployment Stack Contributor",
                        "resourceGroupId": "stg"
                    }
                ]
            },
            "githubEnvironment": {
                "name": "${environmentCode}-infra",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}"
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": [
                    {
                        "name": "ENV_CODE",
                        "value": "${environmentCode}"
                    },
                    {
                        "name": "RESOURCE_GROUP_NAME",
                        "value": "rg-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    },
                    {
                        "name": "DEPLOYMENT_STACK_NAME",
                        "value": "rgds-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    }
                ]
            },
            "workloadUserAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}-workload",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}-workload",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "resourceGroupId": "stg"
                    }
                ]
            },
            "workloadGithubEnvironment": {
                "name": "${environmentCode}-workload",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}"
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": [
                    {
                        "name": "ENV_CODE",
                        "value": "${environmentCode}"
                    },
                    {
                        "name": "RESOURCE_GROUP_NAME",
                        "value": "rg-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    }
                ]
            }
        },
        {
            "displayName": "Production",
            "environmentCode": "prd",
            "description": "Production environment for the ${displayName} service",
            "resourceGroupId": "prd",
            "userAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "resourceGroupId": "prd"
                    },
                    {
                        "role": "Azure Deployment Stack Contributor",
                        "resourceGroupId": "prd"
                    }
                ]
            },
            "githubEnvironment": {
                "name": "${environmentCode}-infra",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}"
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": [
                    {
                        "name": "ENV_CODE",
                        "value": "${environmentCode}"
                    },
                    {
                        "name": "RESOURCE_GROUP_NAME",
                        "value": "rg-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    },
                    {
                        "name": "DEPLOYMENT_STACK_NAME",
                        "value": "rgds-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    }
                ]
            },
            "workloadUserAssignedIdentity": {
                "name": "id-${serviceShort}${uniqueId}-${tool}-${environmentCode}-workload",
                "federatedCredential": {
                    "name": "fic-${serviceShort}${uniqueId}-${tool}-${environmentCode}-workload",
                    "issuer": "https://token.actions.githubusercontent.com",
                    "subjectType": "environment",
                    "audiences": [
                        "api://AzureADTokenExchange"
                    ]
                },
                "roleAssignments": [
                    {
                        "role": "Contributor",
                        "resourceGroupId": "prd"
                    }
                ]
            },
            "workloadGithubEnvironment": {
                "name": "${environmentCode}-workload",
                "protectionRules": {
                    "requiredReviewers": [],
                    "waitTimerMinutes": 0
                },
                "secrets": [
                    {
                        "name": "AZURE_CLIENT_ID",
                        "value": "${clientId}"
                    },
                    {
                        "name": "AZURE_SUBSCRIPTION_ID",
                        "value": "${subscriptionId}"
                    },
                    {
                        "name": "AZURE_TENANT_ID",
                        "value": "${tenantId}"
                    }
                ],
                "variables": [
                    {
                        "name": "ENV_CODE",
                        "value": "${environmentCode}"
                    },
                    {
                        "name": "RESOURCE_GROUP_NAME",
                        "value": "rg-${serviceShort}${uniqueId}-${environmentCode}-${regionCode}"
                    }
                ]
            }
        }
    ]
}
